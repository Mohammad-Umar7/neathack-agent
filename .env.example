# neatlogs: app.neatlogs.com -> create a project -> copy its API key
NEATLOGS_API_KEY=

# LLM: any OpenAI-compatible endpoint. Defaults are the neatHack LiteLLM proxy.
# Key: https://neatlogs.com/hackathon/models (one shared key per team, $20 budget).
# Every teammate must finish web check-in, then the team leader verifies their email.
# Models: claude-sonnet-4.6, claude-opus-4.6, claude-haiku, nova-pro, nova-lite, nova-micro, nova-2-lite
LLM_BASE_URL=https://litellm.vision.aivar.app/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4.6
